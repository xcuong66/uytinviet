# uytinviet
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tra cứu lừa đảo</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <!-- Header -->
  <header class="bg-white shadow p-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">TRA CỨU LỪA ĐẢO</h1>
    </div>
  </header>

  <!-- Tra cứu -->
  <section class="max-w-2xl mx-auto mt-10 bg-white p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4">Tra cứu thông tin nghi ngờ lừa đảo</h2>
    <input id="searchInput" type="text" placeholder="Nhập số điện thoại, tài khoản ngân hàng..." class="w-full p-3 border rounded mb-4" />
    <button onclick="searchScam()" class="bg-blue-600 text-white px-4 py-2 rounded">Tra cứu</button>
    <div id="searchResult" class="mt-6"></div>
  </section>

  <!-- Gửi báo cáo -->
  <section class="max-w-2xl mx-auto mt-10 bg-white p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4">Gửi báo cáo lừa đảo</h2>
    <form id="reportForm" onsubmit="submitReport(event)">
      <input required name="info" placeholder="Thông tin lừa đảo (số ĐT, STK...)" class="w-full p-3 border rounded mb-4" />
      <textarea required name="desc" placeholder="Mô tả chi tiết vụ việc" class="w-full p-3 border rounded mb-4"></textarea>
      <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded">Gửi báo cáo</button>
    </form>
    <div id="reportMessage" class="mt-4 text-green-600 font-medium"></div>
  </section>

  <!-- Footer -->
  <footer class="text-center text-sm text-gray-500 mt-10 p-4">
    © 2025 Trang tra cứu lừa đảo. Nội dung do người dùng đóng góp.
  </footer>

  <script>
    // Dữ liệu mẫu để minh họa
    const scamList = [
      { info: '0912345678', desc: 'Gọi điện giả danh công an.' },
      { info: '123456789', desc: 'STK dùng để lừa đảo chuyển tiền.' }
    ];

    function searchScam() {
      const input = document.getElementById('searchInput').value.trim();
      const result = scamList.find(entry => entry.info.includes(input));
      const output = document.getElementById('searchResult');
      if (result) {
        output.innerHTML = `<div class='text-red-600 font-semibold'>CẢNH BÁO: Có dấu hiệu lừa đảo!</div><p>${result.desc}</p>`;
      } else {
        output.innerHTML = `<div class='text-green-600 font-semibold'>Không tìm thấy thông tin lừa đảo.</div>`;
      }
    }

    function submitReport(event) {
      event.preventDefault();
      const form = document.getElementById('reportForm');
      const formData = new FormData(form);
      const newReport = {
        info: formData.get('info'),
        desc: formData.get('desc')
      };
      scamList.push(newReport);
      form.reset();
      document.getElementById('reportMessage').innerText = 'Cảm ơn bạn đã gửi báo cáo!';
    }
  </script>
</body>
</html>
